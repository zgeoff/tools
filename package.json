{
  "name": "tools",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@actions/expressions": "0.3.61",
      "@commitlint/cli": "21.2.4",
      "@commitlint/lint": "21.2.4",
      "@commitlint/load": "21.2.4",
      "@happy-dom/global-registrator": "21.0.4",
      "@maschwenk/tsrslint": "0.1.6",
      "@stylistic/eslint-plugin": "5.10.0",
      "@testing-library/jest-dom": "7.0.1",
      "@testing-library/react": "16.3.3",
      "@tsconfig/strictest": "2.0.8",
      "@types/bun": "1.4.3",
      "@types/picomatch": "4.0.3",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "ajv": "8.20.0",
      "gunshi": "1.0.0-rc.1",
      "happy-dom": "21.0.4",
      "jest-extended": "7.0.0",
      "jest-matcher-utils": "30.5.2",
      "kysely": "0.29.7",
      "lefthook": "2.2.2",
      "msw": "2.15.0",
      "oxfmt": "0.72.0",
      "oxlint": "1.87.0",
      "picomatch": "4.0.7",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "simple-git": "4.0.2",
      "tiny-invariant": "1.3.3",
      "ts-pattern": "5.9.2",
      "tsrs": "0.18.0-ts7.1.0-dev.20260929",
      "type-fest": "5.10.0",
      "typescript": "7.0.2",
      "xstate": "5.33.3",
      "zod": "4.6.7",
      "zustand": "5.0.15"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "lefthook install --force || true; bun run build",
    "typecheck": "bun run --filter '*' typecheck && tsrs -p . && tsrs -p scripts && tsrs -p sync && tsrs -p test-utils && tsrs -p e2e && tsrs -p integration",
    "test": "rig unit",
    "test:related": "rig related",
    "test:browser": "rig browser",
    "test:e2e": "rig e2e",
    "test:host": "rig host",
    "build": "bun run --filter '*' build",
    "lint": "oxlint",
    "lint:files": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix",
    "lint:full": "tsgolint=$(tsrslint-path) && OXLINT_TSGOLINT_PATH=$tsgolint oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "format": "oxfmt . && bun packages/format-codemod/src/cli.ts --quiet .",
    "format:check": "oxfmt --check . && bun packages/format-codemod/src/cli.ts --check --quiet .",
    "check:sync": "bash scripts/check-sync-manifest.sh",
    "check:release-workflow": "bun scripts/release/run-release-workflow-check.ts",
    "check:repo-sync-concurrency": "bun scripts/repo-sync/run-repo-sync-concurrency-check.ts",
    "check:renovate-config": "bun scripts/renovate/run-renovate-config-check.ts",
    "ci:install-tool": "bun scripts/ci/run-pinned-tool-step.ts",
    "ci:dispatch-publish": "bun scripts/publish/dispatch-release-publish.ts",
    "ci:plan-sync-dispatch": "bun scripts/repo-sync/write-sync-dispatch-plan.ts",
    "ci:send-sync-dispatches": "bun scripts/repo-sync/write-sync-dispatches.ts",
    "ci:publish-packages": "bun scripts/publish/publish-packages.ts",
    "files:branch": "bun sync/pre-push/read-branch-files.ts",
    "check:commits": "bun sync/pre-push/run-commits-check.ts",
    "check:local-paths": "bun sync/pre-push/run-local-paths-check.ts",
    "check:test-timeouts": "bun sync/pre-push/run-test-timeouts-check.ts",
    "check:dependency-gates": "bun sync/pre-push/dependency-gates/run-dependency-gates-check.ts",
    "check:workflows": "bun sync/pre-push/run-workflows-check.ts",
    "check:uncommitted": "bun sync/pre-push/run-uncommitted-check.ts",
    "memory-capped": "diet --"
  },
  "devDependencies": {
    "@actions/expressions": "catalog:",
    "@commitlint/cli": "catalog:",
    "@maschwenk/tsrslint": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@types/bun": "catalog:",
    "@zgeoff/agent-hooks": "workspace:*",
    "@zgeoff/bun-test-extended": "workspace:*",
    "@zgeoff/bun-test-react": "workspace:*",
    "@zgeoff/commitlint-config": "workspace:*",
    "@zgeoff/diet": "workspace:*",
    "@zgeoff/format-codemod": "workspace:*",
    "@zgeoff/oxfmt-config": "workspace:*",
    "@zgeoff/oxlint-config": "workspace:*",
    "@zgeoff/rig": "workspace:*",
    "@zgeoff/skill-gate": "workspace:*",
    "@zgeoff/tsconfig": "workspace:*",
    "lefthook": "catalog:",
    "msw": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tiny-invariant": "catalog:",
    "ts-pattern": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
