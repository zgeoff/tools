{
  "name": "tools",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@commitlint/cli": "21.2.3",
      "@happy-dom/global-registrator": "21.0.4",
      "@stylistic/eslint-plugin": "5.10.0",
      "@testing-library/jest-dom": "7.0.1",
      "@testing-library/react": "16.3.3",
      "@tsconfig/strictest": "2.0.8",
      "@types/bun": "1.4.2",
      "@types/picomatch": "4.0.3",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "ajv": "8.20.0",
      "gunshi": "1.0.0-rc.1",
      "happy-dom": "21.0.4",
      "jest-extended": "7.0.0",
      "jest-matcher-utils": "30.5.2",
      "kysely": "0.29.6",
      "lefthook": "2.2.1",
      "oxfmt": "0.72.0",
      "oxlint": "1.87.0",
      "oxlint-tsgolint": "7.0.2004",
      "picomatch": "4.0.7",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "simple-git": "4.0.2",
      "tiny-invariant": "1.3.3",
      "ts-pattern": "5.9.0",
      "tsrs": "0.18.0-ts7.1.0-dev.20260929",
      "type-fest": "5.10.0",
      "typescript": "7.0.2",
      "xstate": "5.33.2",
      "zod": "4.6.6",
      "zustand": "5.0.15"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "lefthook install --force || true",
    "typecheck": "bun run --filter '*' typecheck && tsrs -p scripts && tsrs -p sync && tsrs -p test-utils && tsrs -p .github/workflows",
    "test": "workers=$(bun sync/pre-push/read-worker-count.ts) && bun test --parallel=$workers",
    "test:workflows": "workers=$(bun sync/pre-push/read-worker-count.ts) && bun test --parallel=$workers ./.github/workflows",
    "test:related": "bun sync/pre-push/run-related-tests.ts",
    "build": "bun run --filter '*' build",
    "lint": "oxlint",
    "lint:files": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix",
    "lint:full": "oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "format": "oxfmt . && bun packages/format-codemod/src/cli.ts --quiet .",
    "format:check": "oxfmt --check . && bun packages/format-codemod/src/cli.ts --check --quiet .",
    "check:sync": "bash scripts/check-sync-manifest.sh",
    "files:branch": "bun sync/pre-push/read-branch-files.ts",
    "check:commits": "bun sync/pre-push/run-commits-check.ts",
    "check:local-paths": "bun sync/pre-push/run-local-paths-check.ts",
    "check:test-timeouts": "bun sync/pre-push/run-test-timeouts-check.ts",
    "memory-capped": "bash sync/pre-push/run-memory-capped.sh \"$(bun sync/pre-push/read-memory-budget.ts)\""
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@types/bun": "catalog:",
    "@zgeoff/bun-test-extended": "workspace:*",
    "@zgeoff/bun-test-react": "workspace:*",
    "@zgeoff/commitlint-config": "workspace:*",
    "@zgeoff/format-codemod": "workspace:*",
    "@zgeoff/oxfmt-config": "workspace:*",
    "@zgeoff/oxlint-config": "workspace:*",
    "@zgeoff/skill-gate": "workspace:*",
    "@zgeoff/tsconfig": "workspace:*",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tiny-invariant": "catalog:",
    "ts-pattern": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:"
  }
}
