[
  {
    "name": "agents",
    "description": "The shared AGENTS.md partial and the script that builds AGENTS.md from it and agents/project.md",
    "files": [
      {
        "source": "agents/shared.md",
        "target": "agents/shared.md"
      },
      {
        "source": "scripts/build-agents-md.sh",
        "target": "scripts/build-agents-md.sh",
        "mode": "0755"
      }
    ],
    "build": "bash scripts/build-agents-md.sh agents/shared.md agents/project.md AGENTS.md"
  },
  {
    "name": "pr-template",
    "description": "The pull-request template",
    "files": [
      {
        "source": ".github/PULL_REQUEST_TEMPLATE.md",
        "target": ".github/PULL_REQUEST_TEMPLATE.md"
      }
    ]
  },
  {
    "name": "editorconfig",
    "description": "The root .editorconfig",
    "files": [
      {
        "source": ".editorconfig",
        "target": ".editorconfig"
      }
    ]
  },
  {
    "name": "workflow-bun-pr",
    "description": "The pull-request workflow that runs the shared Bun checks",
    "optIn": true,
    "files": [
      {
        "source": "sync/workflow-callers/pr.yml",
        "target": ".github/workflows/pr.yml"
      }
    ]
  },
  {
    "name": "skill-testing",
    "description": "The shared testing skill; a repo keeps its own rules in a project-testing skill",
    "optIn": true,
    "files": [
      {
        "source": "sync/skills/testing/SKILL.md",
        "target": ".claude/skills/testing/SKILL.md"
      }
    ]
  },
  {
    "name": "skill-docs-writing",
    "description": "The shared docs-writing skill and its prose check script; a repo keeps its own rules in a project-docs-writing skill",
    "optIn": true,
    "files": [
      {
        "source": "sync/skills/docs-writing/SKILL.md",
        "target": ".claude/skills/docs-writing/SKILL.md"
      },
      {
        "source": "sync/skills/docs-writing/scripts/check-prose.sh",
        "target": ".claude/skills/docs-writing/scripts/check-prose.sh",
        "mode": "0755"
      }
    ]
  }
]
