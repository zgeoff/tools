    "scripts": {
      "files:branch": "bun scripts/read-branch-files.ts",
      "lint:files": "oxlint --no-error-on-unmatched-pattern",
      "test:related": "bun scripts/run-related-tests.ts",
      "check:commits": "bun scripts/run-commits-check.ts",
      "check:local-paths": "bun scripts/run-local-paths-check.ts",
      "check:test-timeouts": "bun scripts/run-test-timeouts-check.ts",
      "check:dependency-gates": "bun scripts/dependency-gates/run-dependency-gates-check.ts",
      "check:workflows": "bun scripts/run-workflows-check.ts",
      "check:uncommitted": "bun scripts/run-uncommitted-check.ts",
      "memory-capped": "bash scripts/run-memory-capped.sh \"$(bun scripts/read-memory-budget.ts)\""
    },
    "build": "old='bun scripts/collect-branch-files.ts'; new='bun scripts/read-branch-files.ts'; if [ \"$(jq -r '.scripts[\"files:branch\"] // empty' package.json)\" = \"$old\" ]; then jq --arg new \"$new\" '.scripts[\"files:branch\"] = $new' package.json > package.json.tmp; mv package.json.tmp package.json; fi; add=$(jq -cn --arg new \"$new\" --arg capped 'bash scripts/run-memory-capped.sh \"$(bun scripts/read-memory-budget.ts)\"' '{\"files:branch\":$new,\"lint:files\":\"oxlint --no-error-on-unmatched-pattern\",\"test:related\":\"bun scripts/run-related-tests.ts\",\"check:commits\":\"bun scripts/run-commits-check.ts\",\"check:local-paths\":\"bun scripts/run-local-paths-check.ts\",\"check:test-timeouts\":\"bun scripts/run-test-timeouts-check.ts\",\"check:dependency-gates\":\"bun scripts/dependency-gates/run-dependency-gates-check.ts\",\"check:workflows\":\"bun scripts/run-workflows-check.ts\",\"check:uncommitted\":\"bun scripts/run-uncommitted-check.ts\",\"memory-capped\":$capped}'); missing=$(jq -c --argjson add \"$add\" '(.scripts // {}) as $s | $add | with_entries(select(.key as $k | $s | has($k) | not))' package.json); if [ \"$missing\" != '{}' ]; then jq --argjson missing \"$missing\" '.scripts = (.scripts // {}) + $missing' package.json > package.json.tmp; mv package.json.tmp package.json; fi"
  }
