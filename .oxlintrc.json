{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  // ignorePatterns don't propagate through extends — each consumer declares
  // its own. .zgeoff-skills holds zgeoff/skills, whose files lint there.
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    ".worktrees/**",
    "**/*.json",
    ".zgeoff-skills/**"
  ],
  "rules": {
    "zgeoff/feature-folders": "error"
  },
  "overrides": [
    {
      // @zgeoff/testing depends on @zgeoff/std, so std cannot import the kit without a cycle;
      // its test helpers stay local copies of the kit's
      "files": ["packages/std/src/test-utils/**"],
      "rules": { "zgeoff/use-testing-kit": "off" }
    }
  ]
}
