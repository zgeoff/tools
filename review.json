{
  "extends": "github:zgeoff/noslop-config",
  "rules": [
    "github:zgeoff/skills/skills/code-style/SKILL.md",
    {
      "path": "github:zgeoff/skills/skills/testing/SKILL.md",
      "references": {
        "references/nixos.md": ["**/*.nix"],
        "references/frontend.md": ["**/*.tsx", "**/*.jsx"],
        "references/go.md": ["**/*.go"],
        "references/database.md": ["**/*.sql", "**/migrations/**", "**/schema.ts", "**/schema/**"],
        "references/http.md": ["**/*.test.ts", "**/*.test.tsx"],
        "references/cleanup.md": [
          "**/*.test.ts",
          "**/*.test.tsx",
          "**/bunfig.toml",
          "**/preload*.ts"
        ],
        "references/factories.md": [
          "**/build-mock-*.ts",
          "**/create-mock-*.ts",
          "**/testing/src/**"
        ],
        "references/observability.md": [
          "**/*metric*.ts",
          "**/*trace*.ts",
          "**/*telemetry*.ts",
          "**/*logger*.ts"
        ],
        "references/shell.md": ["**/*.sh"],
        "references/system-tests.md": ["e2e/**", "evals/**"],
        "references/claude-code-mods.md": ["mods/**", "**/.claude-plugin/**"]
      }
    },
    {
      "path": "github:zgeoff/skills/skills/docs-writing/SKILL.md",
      "references": {
        "references/architecture-docs.md": ["docs/architecture/**"],
        "references/docs-tree.md": ["docs/**"],
        "references/readmes.md": ["**/README.md"]
      }
    }
  ],
  "instructions": [
    "**/AGENTS.md",
    "**/CLAUDE.md",
    "**/SKILL.md",
    ".claude/**/*.md",
    ".cursor/rules/**"
  ]
}
