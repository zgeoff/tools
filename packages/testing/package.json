{
  "name": "@zgeoff/testing",
  "version": "0.4.0",
  "description": "Drive a real program from a Bun test, in a pseudo-terminal or as a process with a ready check",
  "keywords": [
    "bun",
    "e2e",
    "process",
    "pty",
    "test"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/tools.git",
    "directory": "packages/testing"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist",
    "!src/test-utils"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./bin": {
      "types": "./dist/bin/index.d.ts",
      "bun": "./src/bin/index.ts",
      "default": "./src/bin/index.ts"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "bun": "./src/cli/index.ts",
      "default": "./src/cli/index.ts"
    },
    "./clock": {
      "types": "./dist/clock/index.d.ts",
      "bun": "./src/clock/index.ts",
      "default": "./src/clock/index.ts"
    },
    "./fetch": {
      "types": "./dist/fetch/index.d.ts",
      "bun": "./src/fetch/index.ts",
      "default": "./src/fetch/index.ts"
    },
    "./fs": {
      "types": "./dist/fs/index.d.ts",
      "bun": "./src/fs/index.ts",
      "default": "./src/fs/index.ts"
    },
    "./git": {
      "types": "./dist/git/index.d.ts",
      "bun": "./src/git/index.ts",
      "default": "./src/git/index.ts"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.ts",
      "bun": "./src/mocks/index.ts",
      "default": "./src/mocks/index.ts"
    },
    "./preload": {
      "types": "./dist/preload/index.d.ts",
      "bun": "./src/preload/index.ts",
      "default": "./src/preload/index.ts"
    },
    "./process": {
      "types": "./dist/process/index.d.ts",
      "bun": "./src/process/index.ts",
      "default": "./src/process/index.ts"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "bun": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsrs --fast"
  },
  "dependencies": {
    "@zgeoff/std": "workspace:*",
    "bun-pty": "catalog:"
  },
  "devDependencies": {
    "@mswjs/interceptors": "catalog:",
    "@types/bun": "catalog:",
    "msw": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@mswjs/interceptors": ">=0.45.11 <0.46",
    "msw": ">=3.0.4 <4"
  },
  "peerDependenciesMeta": {
    "@mswjs/interceptors": {
      "optional": true
    },
    "msw": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
