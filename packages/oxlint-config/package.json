{
  "name": "@zgeoff/oxlint-config",
  "version": "0.10.1",
  "description": "Shareable oxlint config: strict categories, house-style rules, and a custom JS plugin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/tools.git",
    "directory": "packages/oxlint-config"
  },
  "files": [
    "oxlintrc.json",
    "react.json",
    "plugin.js",
    "function-verb.js",
    "verb-contract.js",
    "collect-type-kinds.js",
    "module-order.js",
    "collect-module-entries.js",
    "build-module-order-fix.js",
    "is-static-value.js",
    "find-function-name.js",
    "is-verb-match.js",
    "no-restricted-words.js",
    "no-abbreviated-names.js",
    "max-consecutive-line-comments.js",
    "no-class.js",
    "no-jsdoc.js",
    "no-comment-rule-override.js",
    "no-hidden-cast.js",
    "build-test-beside-module.js",
    "no-file-snapshot.js",
    "setup-test-only.js",
    "build-max-test-timeout.js",
    "test-timeout-exception-ticket.js",
    "build-lane-limits.js",
    "read-rig-lanes.js",
    "resolve-suite-directory.js",
    "no-test-sleep.js",
    "no-require.js",
    "get-imported-name.js",
    "test-shape.js",
    "banned-test-calls.js",
    "is-bun-test-file.js",
    "find-bun-test-name.js",
    "find-chain-root.js",
    "find-static-key.js",
    "import-zones.js",
    "import-zones-schema.js",
    "import-zones/index.js",
    "import-zones/index.d.ts",
    "collect-refusing-edges.js",
    "is-edge-refusing.js",
    "is-entry-applying.js",
    "is-in-any-zone.js",
    "collect-zone-names.js",
    "resolve-repo-root.js",
    "load-workspace-manifests.js",
    "get-zone-options.js",
    "make-glob-matcher.js",
    "resolve-import-target.js",
    "feature-folders.js",
    "pick-folder-kind.js",
    "pick-loose-module-message.js",
    "collect-entry-targets.js",
    "read-loose-modules.js",
    "resolve-source-package.js",
    "find-feature-folder.js",
    "build-import-settings.js",
    "read-stale-pending.js",
    "read-package-manifest.js",
    "read-module-paths.js",
    "build-seed-only.js",
    "test-beside-seed.js",
    "file-named-for-export.js",
    "read-folder-sources.js",
    "collect-written-tables.js",
    "collect-sql-writes.js",
    "to-table-name.js",
    "resolve-repo-path.js",
    "is-in-test-utils.js",
    "index.js"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./oxlintrc.json": "./oxlintrc.json",
    "./react.json": "./react.json",
    "./plugin": "./plugin.js",
    "./import-zones": {
      "types": "./import-zones/index.d.ts",
      "default": "./import-zones/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsrs"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@zgeoff/rig": "workspace:*",
    "@zgeoff/std": "workspace:*",
    "@zgeoff/testing": "workspace:*",
    "tsrs": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "oxlint": ">=1.78.0"
  }
}
