{
  "name": "@zgeoff/kysely-bun-sqlite",
  "version": "0.1.0",
  "description": "A Kysely driver and dialect for a bun:sqlite database handle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/tools.git",
    "directory": "packages/kysely-bun-sqlite"
  },
  "files": [
    "src",
    "!src/*.test.ts",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "bun run build",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "kysely": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "kysely": ">=0.29.5 <0.30.0"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
