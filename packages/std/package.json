{
  "name": "@zgeoff/std",
  "version": "0.3.1",
  "description": "Small, dependency-free TypeScript helpers shared across the zgeoff repos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/tools.git",
    "directory": "packages/std"
  },
  "files": [
    "src",
    "!src/*.test.ts",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsrs"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "tsrs": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "xstate": "catalog:"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
