{
  "name": "@zgeoff/skill-gate",
  "version": "0.2.11",
  "description": "Moved to @zgeoff/agent-hooks: this release runs the skill gate from that package",
  "keywords": [
    "claude-code",
    "codex",
    "hook",
    "skills"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/tools.git",
    "directory": "packages/skill-gate"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target bun --outdir dist --packages external && tsc -p tsconfig.build.json",
    "typecheck": "tsrs"
  },
  "dependencies": {
    "@zgeoff/agent-hooks": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
