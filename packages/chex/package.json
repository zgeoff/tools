{
  "name": "@zgeoff/chex",
  "version": "0.4.4",
  "description": "Run each shared docs and repo check as one subcommand, with the lefthook pre-push baseline that calls them",
  "keywords": [
    "checks",
    "docs",
    "lefthook",
    "pre-push"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/tools.git",
    "directory": "packages/chex"
  },
  "bin": {
    "chex": "./src/cli.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "lefthook.yml",
    "!src/test-utils"
  ],
  "type": "module",
  "exports": {
    "./test-utils/*": "./src/test-utils/*.ts",
    "./src/build-init-package.ts": "./src/init/build-init-package.ts",
    "./src/build-init-plan.ts": "./src/init/build-init-plan.ts",
    "./src/build-lefthook-extends.ts": "./src/lefthook/build-lefthook-extends.ts",
    "./src/build-lefthook-guard.ts": "./src/lefthook/build-lefthook-guard.ts",
    "./src/check-names.ts": "./src/cli/check-names.ts",
    "./src/collect-command-names.ts": "./src/workflows/collect-command-names.ts",
    "./src/collect-concurrency-findings.ts": "./src/workflows/collect-concurrency-findings.ts",
    "./src/collect-expression-references.ts": "./src/workflows/collect-expression-references.ts",
    "./src/find-install-cache-path.ts": "./src/workflows/find-install-cache-path.ts",
    "./src/find-member.ts": "./src/workflows/find-member.ts",
    "./src/format-commit-lines.ts": "./src/commits/format-commit-lines.ts",
    "./src/get-top-level-line.ts": "./src/workflows/get-top-level-line.ts",
    "./src/make-check-runner.ts": "./src/cli/make-check-runner.ts",
    "./src/make-file-probe.ts": "./src/uncommitted/make-file-probe.ts",
    "./src/parse-added-lines.ts": "./src/local-paths/parse-added-lines.ts",
    "./src/parse-chex-args.ts": "./src/cli/parse-chex-args.ts",
    "./src/parse-lane-limits.ts": "./src/test-timeouts/parse-lane-limits.ts",
    "./src/parse-lefthook-config.ts": "./src/lefthook/parse-lefthook-config.ts",
    "./src/parse-pushed-refs.ts": "./src/push/parse-pushed-refs.ts",
    "./src/parse-rig-lane-limits.ts": "./src/test-timeouts/parse-rig-lane-limits.ts",
    "./src/parse-shell-words.ts": "./src/shell/parse-shell-words.ts",
    "./src/pick-merge-blobs-command.ts": "./src/local-paths/pick-merge-blobs-command.ts",
    "./src/pull-request-triggers.ts": "./src/workflows/pull-request-triggers.ts",
    "./src/read-branch-base.ts": "./src/branch/read-branch-base.ts",
    "./src/read-branch-files.ts": "./src/branch/read-branch-files.ts",
    "./src/read-checks-profile.ts": "./src/workflows/read-checks-profile.ts",
    "./src/read-pushed-ranges.ts": "./src/push/read-pushed-ranges.ts",
    "./src/read-pushed-refs-input.ts": "./src/push/read-pushed-refs-input.ts",
    "./src/read-range-commits.ts": "./src/commits/read-range-commits.ts",
    "./src/run-chex.ts": "./src/cli/run-chex.ts",
    "./src/run-commits-check.ts": "./src/commits/run-commits-check.ts",
    "./src/run-init.ts": "./src/init/run-init.ts",
    "./src/run-local-paths-check.ts": "./src/local-paths/run-local-paths-check.ts",
    "./src/run-program.ts": "./src/program/run-program.ts",
    "./src/run-test-layout-check.ts": "./src/test-layout/run-test-layout-check.ts",
    "./src/run-test-timeouts-check.ts": "./src/test-timeouts/run-test-timeouts-check.ts",
    "./src/run-uncommitted-check.ts": "./src/uncommitted/run-uncommitted-check.ts",
    "./src/run-workflows-check.ts": "./src/workflows/run-workflows-check.ts",
    "./src/shell-escape-parsers.ts": "./src/shell/shell-escape-parsers.ts",
    "./src/workflow-context.ts": "./src/workflows/workflow-context.ts",
    "./src/write-step-outputs.ts": "./src/output/write-step-outputs.ts",
    "./src/write-text-file.ts": "./src/output/write-text-file.ts",
    "./*": "./*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsrs --fast"
  },
  "dependencies": {
    "@zgeoff/std": "workspace:*",
    "oxc-parser": "catalog:",
    "ts-pattern": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@zgeoff/rig": "workspace:*",
    "@zgeoff/std": "workspace:*",
    "@zgeoff/testing": "workspace:*",
    "@zgeoff/tools-scripts": "workspace:*",
    "msw": "catalog:",
    "tiny-invariant": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
