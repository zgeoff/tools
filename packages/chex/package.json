{
  "name": "@zgeoff/chex",
  "version": "0.0.10",
  "description": "Run each shared docs and repo check as one subcommand, with the lefthook pre-push baseline that calls them",
  "keywords": [
    "checks",
    "docs",
    "lefthook",
    "pre-push"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgeoff/tools.git",
    "directory": "packages/chex"
  },
  "bin": {
    "chex": "./src/cli.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "lefthook.yml",
    "!src/test-utils"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsrs"
  },
  "dependencies": {
    "@zgeoff/std": "workspace:*",
    "ts-pattern": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@zgeoff/std": "workspace:*",
    "tiny-invariant": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
