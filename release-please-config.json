{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bootstrap-sha": "1a512ef950e2d4beb4a8398036c245cd75b612ae",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": true,
  "include-v-in-tag": false,
  "tag-separator": "@",
  "plugins": ["node-workspace"],
  "packages": {
    "packages/bun-test-extended": {
      "component": "@zgeoff/bun-test-extended"
    },
    "packages/commitlint-config": {
      "component": "@zgeoff/commitlint-config",
      "initial-version": "0.1.0"
    },
    "packages/format-codemod": {
      "component": "@zgeoff/format-codemod"
    },
    "packages/oxfmt-config": {
      "component": "@zgeoff/oxfmt-config",
      "initial-version": "0.1.0"
    },
    "packages/oxlint-config": {
      "component": "@zgeoff/oxlint-config"
    },
    "packages/tsconfig": {
      "component": "@zgeoff/tsconfig"
    }
  }
}
